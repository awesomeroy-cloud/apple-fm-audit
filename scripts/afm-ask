#!/bin/sh
# Query Apple Foundation Model via apple-fm-audit proxy
set -eu

MODEL="${AFM_MODEL:-system}"
API_URL="${AFM_API_URL:-http://127.0.0.1:1977/v1/chat/completions}"
SYSTEM_PROMPT=""
TEMPERATURE=""
PROMPT=""

usage() {
  cat <<EOF
Usage: afm-ask [options] [prompt]

Arguments:
  prompt                   Prompt text. If omitted, input is read from stdin.

Options:
  -m, --model <model>      Target model: 'system' or 'pcc' (default: ${MODEL})
  -s, --system <text>      System instruction / prompt context
  -u, --url <url>          API URL (default: ${API_URL})
  -t, --temperature <val>  Sampling temperature
  -h, --help               Show help information
EOF
  exit 0
}

while [ $# -gt 0 ]; do
  case "$1" in
    -m|--model)
      MODEL="$2"
      shift 2
      ;;
    -s|--system)
      SYSTEM_PROMPT="$2"
      shift 2
      ;;
    -u|--url)
      API_URL="$2"
      shift 2
      ;;
    -t|--temperature)
      TEMPERATURE="$2"
      shift 2
      ;;
    -h|--help)
      usage
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
    *)
      if [ -z "${PROMPT}" ]; then
        PROMPT="$1"
      else
        PROMPT="${PROMPT} $1"
      fi
      shift
      ;;
  esac
done

if [ -z "${PROMPT}" ]; then
  if [ -t 0 ]; then
    usage
  else
    PROMPT="$(cat)"
  fi
fi

if [ -z "${PROMPT}" ]; then
  echo "Error: Empty prompt received." >&2
  exit 1
fi

json_escape() {
  printf '%s' "$1" | awk '
    BEGIN { RS="^$"; ORS="" }
    {
      gsub(/\\/, "\\\\");
      gsub(/"/, "\\\"");
      gsub(/\r/, "\\r");
      gsub(/\n/, "\\n");
      gsub(/\t/, "\\t");
      print;
    }'
}

ESC_PROMPT="$(json_escape "${PROMPT}")"

if [ -n "${SYSTEM_PROMPT}" ]; then
  ESC_SYS="$(json_escape "${SYSTEM_PROMPT}")"
  MESSAGES="[{\"role\":\"system\",\"content\":\"${ESC_SYS}\"},{\"role\":\"user\",\"content\":\"${ESC_PROMPT}\"}]"
else
  MESSAGES="[{\"role\":\"user\",\"content\":\"${ESC_PROMPT}\"}]"
fi

if [ -n "${TEMPERATURE}" ]; then
  PAYLOAD="{\"model\":\"${MODEL}\",\"messages\":${MESSAGES},\"stream\":false,\"temperature\":${TEMPERATURE}}"
else
  PAYLOAD="{\"model\":\"${MODEL}\",\"messages\":${MESSAGES},\"stream\":false}"
fi

RESP="$(curl -s -f -X POST "${API_URL}" \
  -H "Content-Type: application/json" \
  -d "${PAYLOAD}" || true)"

if [ -z "${RESP}" ]; then
  echo "Error: Failed to fetch response from ${API_URL}" >&2
  exit 1
fi

CONTENT="$(printf '%s' "${RESP}" | plutil -extract "choices.0.message.content" raw -o - - 2>/dev/null || true)"

if [ -n "${CONTENT}" ]; then
  printf '%s\n' "${CONTENT}"
else
  ERR_MSG="$(printf '%s' "${RESP}" | plutil -extract "error.message" raw -o - - 2>/dev/null || true)"
  if [ -n "${ERR_MSG}" ]; then
    echo "Error: ${ERR_MSG}" >&2
  else
    echo "Error: Received unrecognized response format:" >&2
    printf '%s\n' "${RESP}" >&2
  fi
  exit 1
fi
